// File name: projects/01/DMux8Way.hdl

/**
 * 8-way demultiplexor:
 * {a, b, c, d, e, f, g, h} = {in, 0, 0, 0, 0, 0, 0, 0} if sel == 000
 *                            {0, in, 0, 0, 0, 0, 0, 0} if sel == 001
 *                            etc.
 *                            {0, 0, 0, 0, 0, 0, 0, in} if sel == 111
 */

CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux4Way(in=in, sel=sel[1..2], a=ABDMux4Way, b=CDDMux4Way, c=EFDMux4Way, d=GHDMux4Way);
    DMux (in=ABDMux4Way, sel=sel[0], a=a, b=b);
    DMux (in=CDDMux4Way, sel=sel[0], a=c, b=d);
    DMux (in=EFDMux4Way, sel=sel[0], a=e, b=f);
    DMux (in=GHDMux4Way, sel=sel[0], a=g, b=h);
}