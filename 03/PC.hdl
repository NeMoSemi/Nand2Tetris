// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];
    
    PARTS:
    Inc16(in=oldValue, out=incIn);

    Mux16(a=oldValue, b=incIn, sel=inc, out=OldOrInc);
    Mux16(a=OldOrInc, b=in, sel=load, out=LoadOrOldOrInc);
    Mux16(a=LoadOrOldOrInc, b=false, sel=reset, out=ResetOrLoadOrOldOrInc);

    Register(in=ResetOrLoadOrOldOrInc, load=true, out=out, out=oldValue);
}
