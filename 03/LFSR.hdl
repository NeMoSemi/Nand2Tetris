CHIP LFSR {
    IN reset;
    OUT out;

    PARTS:

    DFF(in=in0, out=bit0);
    DFF(in=in1, out=bit1);
    DFF(in=in2, out=bit2);
    DFF(in=in3, out=bit3, out=out);

    Xor(a=bit2, b=bit3, out=first);


    Mux(a=first, b=true,  sel=reset, out=in0);
    Mux(a=bit0, b=false, sel=reset, out=in1);
    Mux(a=bit1, b=false, sel=reset, out=in2);
    Mux(a=bit2, b=true,  sel=reset, out=in3);
}
