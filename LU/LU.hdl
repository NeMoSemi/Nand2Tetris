/**
 * Logic Unit gate: 
 * sel — определяет, какую операцию нужно применять:
 *      And16   if sel == 00
 *      Or16    if sel == 01
 *      Nand16  if sel == 10
 *      Nor16   if sel == 11
 * negateA — нужно ли предварительно применить отрицание ко входу A перед применение операции
 * negateB — нужно ли предварительно применить отрицание ко входу B перед применение операции
 */

CHIP Amplifier {
    IN in;
    OUT out[16];

    PARTS:
	And (a=in, b=in, out=out[0]);
	And (a=in, b=in, out=out[1]);
	And (a=in, b=in, out=out[2]);
	And (a=in, b=in, out=out[3]);
	And (a=in, b=in, out=out[4]);
	And (a=in, b=in, out=out[5]);
	And (a=in, b=in, out=out[6]);
	And (a=in, b=in, out=out[7]);
	And (a=in, b=in, out=out[8]);
	And (a=in, b=in, out=out[9]);
	And (a=in, b=in, out=out[10]);
	And (a=in, b=in, out=out[11]);
	And (a=in, b=in, out=out[12]);
	And (a=in, b=in, out=out[13]);
	And (a=in, b=in, out=out[14]);
	And (a=in, b=in, out=out[15]);
}

CHIP LU {
    IN a[16], b[16], sel[2], negateA, negateB;
    OUT out[16];

    PARTS:
    Not16(in=a, out=nota);
    Mux16(a=a, b=nota, sel=negateA, out=a1);
    Not16(in=b, out=notb);
    Mux16(a=b, b=notb, sel=negateB, out=b1);

    Nand16 (a=a1, b=b1, out=nand16);
    Not16 (in=nand16, out=and16);
    Or16 (a=a1, b=b1, out=or16);
    Not16 (in=or16, out=nor16);

    Mux4Way16(a=and16, b=or16, c=nand16, d=nor16, sel=sel, out=out);
}
